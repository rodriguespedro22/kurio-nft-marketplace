# Copie para .env.local para sobrescrever localmente. Nenhuma variável é secreta.

# Liga a camada de mocks (MSW: REST + Socket.IO simulados no navegador).
# Já vem 'true' em .env.development (pnpm dev) e .env.demo (pnpm build:demo).
VITE_ENABLE_MOCKS=true

# Base das chamadas REST (Axios). Interceptada pelo MSW quando os mocks estão ligados.
VITE_API_URL=/api

# Caminho do endpoint Socket.IO (transporte WebSocket interceptado pelo MSW).
VITE_SOCKET_PATH=/socket.io
